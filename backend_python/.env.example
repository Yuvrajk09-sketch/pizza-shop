# SliceCraft Backend Environment Configuration
PROJECT_NAME="SliceCraft Artisan Pizza API"

# PostgreSQL connection URL (e.g. postgresql+asyncpg://postgres:password@localhost:5432/pizza_db)
# If PostgreSQL is not yet running, the backend automatically uses sqlite+aiosqlite:///./pizza_app.db so development never halts!
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pizza_db

# JWT Security
JWT_SECRET=super-secret-slicecraft-artisan-pizza-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
